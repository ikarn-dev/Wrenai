# Public origin of this app. NEP-413 sign-in binds signatures to this value.
APP_URL=http://localhost:3000

# NEAR mainnet JSON-RPC endpoint.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# Pooled managed Postgres URL (Neon, Supabase or another compatible provider).
# Set sslmode=verify-full to verify the server certificate and hostname.
# Supabase poolers also need &sslrootcert=certs/supabase-root-2021.crt (official CA included in this project).
DATABASE_URL=

# Shared request limits across Vercel functions. Financial state stays in Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NEAR AI Cloud keys, comma-separated. Used one at a time; rotated on 401 / 429.
NEAR_AI_API_KEY=

# Tavily free Researcher key (1,000 credits/month, no card). Uses basic searches only.
# Get a key from https://app.tavily.com and keep the account on the free plan.
TAVILY_API_KEY=

# NEAR Intents 1Click partner JWT.
ONECLICK_JWT=

# Master for delegated-key sealing and domain-separated chat encryption: 32 bytes in base64.
# Generate once with: openssl rand -base64 32. Keep it stable and backed up.
# Losing/changing it makes stored agent keys and existing chat history unreadable.
KEY_ENCRYPTION_KEY=

# CoinGecko Demo (free) key for Spot volume, market cap, price change and icons.
# Get one at https://www.coingecko.com/en/api/pricing (Demo plan: 30 calls/min, 10,000/month). Server-only.
COINGECKO_API_KEY=

# Optional wallet-token discovery credential if FastNear requires authenticated access. Server-only.
FASTNEAR_API_KEY=

# Lets this local copy fund, deploy and run agents on NEAR mainnet (real funds). On Vercel, agents run
# without it. Locally, agents use the workflow runtime of `pnpm dev` and keep running only while it does.
# Leave unset unless you intend to move real funds from this machine. Set to 1 to enable.
WRENAI_LOCAL_EXECUTION=

# Optional: the documentation site the sidebar links to (DocsSite/). Defaults to https://docs.wrenai.xyz.
# Set it to http://localhost:3002 to link to the docs dev server.
DOCS_URL=

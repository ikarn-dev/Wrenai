{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/.swc",
      "!**/.vitest",
      "!src/app/.well-known/workflow",
      "!**/node_modules",
      "!**/drizzle",
      "!**/data",
      "!**/next-env.d.ts",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "actions": { "source": { "organizeImports": "on" } }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noTsIgnore": "error",
        "noVar": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noDefaultExport": "error",
        "useBlockStatements": "error",
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 500 } }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/**/page.tsx",
        "src/app/**/layout.tsx",
        "src/app/**/error.tsx",
        "src/app/**/loading.tsx",
        "src/app/**/not-found.tsx",
        "*.config.ts",
        "*.config.mjs"
      ],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
